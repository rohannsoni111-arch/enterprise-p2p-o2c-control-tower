# ==============================================================================
# Enterprise P2P & O2C Digital Control Tower - Environment Configuration Template
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection
# PostgreSQL Database URL format:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sap_control_tower?schema=public"
# For zero-dependency local development (SQLite fallback):
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret & Expiration
JWT_SECRET="enterprise_control_tower_jwt_super_secure_secret_key_2026"
JWT_EXPIRES_IN="24h"

# Application Settings
ENABLE_AUDIT_LOGGING=true
DEFAULT_PRICE_TOLERANCE_PCT=2.0
DEFAULT_DELIVERY_TOLERANCE_PCT=5.0
